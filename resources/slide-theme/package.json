{
  "name": "slidev-theme-optiop-theme",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev ../../lab.01-cadvisor-prometheus/slides/slides.md",
    "slides": "slidev slides.md --open",
    "example": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^51.1.0"
  },
  "devDependencies": {
    "@slidev/cli": "^51.1.0"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "heading": "Space Grotesk",
        "sans": "IBM Plex Sans",
        "mono": "Space Grotesk"
      }
    }
  }
}
